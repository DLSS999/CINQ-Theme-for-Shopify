{% liquid
  assign selected_collection = section.settings.collection
  assign product_limit = section.settings.product_limit
  assign real_count = 0

  if selected_collection != blank
    assign real_count = selected_collection.products.size
    if real_count > product_limit
      assign real_count = product_limit
    endif
  endif
%}

<section
  class="cinq-loop-carousel"
  data-cinq-loop-carousel
  data-section-id="{{ section.id }}"
  data-count="{{ real_count }}"
  style="--cinq-columns-desktop: {{ section.settings.columns_desktop }}; --cinq-columns-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="cinq-loop-carousel__inner page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="cinq-loop-carousel__header">
        {% if section.settings.heading != blank %}
          <h2 class="cinq-loop-carousel__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="cinq-loop-carousel__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if selected_collection != blank and real_count > 0 %}
      <div class="cinq-loop-carousel__shell">
        {% if section.settings.show_arrows %}
          <button class="cinq-loop-carousel__arrow cinq-loop-carousel__arrow--prev" type="button" aria-label="Previous products">‹</button>
        {% endif %}

        <div class="cinq-loop-carousel__viewport">
          <div class="cinq-loop-carousel__track">
            {% for repeat in (1..3) %}
              {% for product in selected_collection.products limit: product_limit %}
                <a href="{{ product.url }}" class="cinq-loop-carousel__slide">
                  <div class="cinq-loop-carousel__image-wrap">
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          class: 'cinq-loop-carousel__image',
                          widths: '300, 450, 600, 750, 900',
                          sizes: '(min-width: 990px) 16vw, 50vw',
                          alt: product.featured_image.alt
                      }}
                    {% else %}
                      <div class="cinq-loop-carousel__placeholder">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>

                  <div class="cinq-loop-carousel__info">
                    {% if product.metafields.custom.season != blank %}
                      <div class="cinq-loop-carousel__season">{{ product.metafields.custom.season }}</div>
                    {% endif %}

                    <div class="cinq-loop-carousel__vendor">{{ product.vendor }}</div>
                    <div class="cinq-loop-carousel__title">{{ product.title }}</div>

                    <div class="cinq-loop-carousel__price">
                      {% if product.compare_at_price > product.price %}
                        <span class="cinq-loop-carousel__compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                      <span class="cinq-loop-carousel__current-price">{{ product.price | money }}</span>
                    </div>
                  </div>
                </a>
              {% endfor %}
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_arrows %}
          <button class="cinq-loop-carousel__arrow cinq-loop-carousel__arrow--next" type="button" aria-label="Next products">›</button>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank %}
        <div class="cinq-loop-carousel__button-wrap">
          <a class="cinq-loop-carousel__button" href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}{{ selected_collection.url }}{% endif %}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="cinq-loop-carousel__empty">Choose a collection in the section settings.</div>
    {% endif %}
  </div>
</section>

<style>
  .cinq-loop-carousel {
    padding: 72px 0;
    background: #ffffff;
    color: #111111;
    overflow: hidden;
  }

  .cinq-loop-carousel__inner {
    position: relative;
  }

  .cinq-loop-carousel__header {
    text-align: center;
    margin-bottom: 72px;
  }

  .cinq-loop-carousel__heading {
    margin: 0;
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.1;
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cinq-loop-carousel__subheading {
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.5;
    font-weight: 300;
    letter-spacing: 0.18em;
    color: #777777;
  }

  .cinq-loop-carousel__shell {
    position: relative;
  }

  .cinq-loop-carousel__viewport {
    overflow: hidden;
    width: 100%;
  }

  .cinq-loop-carousel__track {
    display: flex;
    gap: 8px;
    will-change: transform;
  }

  .cinq-loop-carousel__slide {
    flex: 0 0 calc((100% - (8px * (var(--cinq-columns-desktop) - 1))) / var(--cinq-columns-desktop));
    text-decoration: none;
    color: inherit;
  }

  .cinq-loop-carousel__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.35;
    background: #f7f7f7;
    overflow: hidden;
  }

  .cinq-loop-carousel__image,
  .cinq-loop-carousel__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .cinq-loop-carousel__image {
    object-fit: contain;
    padding: 16px;
    transition: transform 0.45s ease;
  }

  .cinq-loop-carousel__slide:hover .cinq-loop-carousel__image {
    transform: scale(1.035);
  }

  .cinq-loop-carousel__info {
    text-align: center;
    padding: 30px 12px 0;
  }

  .cinq-loop-carousel__season {
    margin-bottom: 8px;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #777777;
  }

  .cinq-loop-carousel__vendor {
    font-size: 15px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cinq-loop-carousel__title {
    margin-top: 22px;
    min-height: 36px;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 300;
    color: #555555;
  }

  .cinq-loop-carousel__price {
    margin-top: 28px;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: #111111;
  }

  .cinq-loop-carousel__compare-price {
    margin-right: 8px;
    color: #888888;
    text-decoration: line-through;
  }

  .cinq-loop-carousel__arrow {
    position: absolute;
    top: 34%;
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: #d8d8d8;
    font-size: 52px;
    line-height: 1;
    font-weight: 200;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .cinq-loop-carousel__arrow:hover {
    color: #111111;
  }

  .cinq-loop-carousel__arrow--prev {
    left: -16px;
  }

  .cinq-loop-carousel__arrow--next {
    right: -16px;
  }

  .cinq-loop-carousel__button-wrap {
    margin-top: 74px;
    text-align: center;
  }

  .cinq-loop-carousel__button {
    display: inline-block;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: #555555;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cinq-loop-carousel__button:hover {
    color: #111111;
  }

  .cinq-loop-carousel__empty {
    text-align: center;
    color: #777777;
  }

  @media screen and (max-width: 749px) {
    .cinq-loop-carousel {
      padding: 48px 0;
    }

    .cinq-loop-carousel__header {
      margin-bottom: 40px;
      padding: 0 20px;
    }

    .cinq-loop-carousel__heading {
      font-size: 26px;
    }

    .cinq-loop-carousel__subheading {
      font-size: 14px;
      letter-spacing: 0.08em;
    }

    .cinq-loop-carousel__slide {
      flex-basis: calc((100% - (8px * (var(--cinq-columns-mobile) - 1))) / var(--cinq-columns-mobile));
    }

    .cinq-loop-carousel__info {
      padding-top: 20px;
    }

    .cinq-loop-carousel__title {
      margin-top: 14px;
      font-size: 13px;
    }

    .cinq-loop-carousel__price {
      margin-top: 20px;
      font-size: 14px;
    }

    .cinq-loop-carousel__arrow {
      display: none;
    }

    .cinq-loop-carousel__button-wrap {
      margin-top: 46px;
    }
  }
</style>

<script>
  (() => {
    function initCinqLoopCarousel(section) {
      if (!section || section.dataset.cinqInitialized === 'true') return;

      const realCount = Number(section.dataset.count || 0);
      const track = section.querySelector('.cinq-loop-carousel__track');
      const prev = section.querySelector('.cinq-loop-carousel__arrow--prev');
      const next = section.querySelector('.cinq-loop-carousel__arrow--next');

      if (!track || realCount <= 1) return;

      section.dataset.cinqInitialized = 'true';

      let index = realCount;
      let isLocked = false;

      function getGap() {
        return parseFloat(window.getComputedStyle(track).gap || 0);
      }

      function getSlideWidth() {
        const slide = track.querySelector('.cinq-loop-carousel__slide');
        if (!slide) return 0;
        return slide.getBoundingClientRect().width + getGap();
      }

      function setPosition(withAnimation = true) {
        const width = getSlideWidth();
        if (!width) return;

        track.style.transition = withAnimation ? 'transform 450ms ease' : 'none';
        track.style.transform = `translate3d(${-index * width}px, 0, 0)`;
      }

      function move(direction) {
        if (isLocked) return;

        isLocked = true;
        index += direction;
        setPosition(true);
      }

      track.addEventListener('transitionend', () => {
        if (index >= realCount * 2) {
          index = realCount;
          setPosition(false);
        }

        if (index < realCount) {
          index = realCount * 2 - 1;
          setPosition(false);
        }

        window.requestAnimationFrame(() => {
          isLocked = false;
        });
      });

      if (prev) prev.addEventListener('click', () => move(-1));
      if (next) next.addEventListener('click', () => move(1));

      window.addEventListener('resize', () => setPosition(false));
      setPosition(false);
    }

    function initAllCinqLoopCarousels() {
      document.querySelectorAll('[data-cinq-loop-carousel]').forEach(initCinqLoopCarousel);
    }

    document.addEventListener('DOMContentLoaded', initAllCinqLoopCarousels);
    document.addEventListener('shopify:section:load', (event) => {
      initCinqLoopCarousel(event.target.querySelector('[data-cinq-loop-carousel]'));
    });
  })();
</script>

{% schema %}
{
  "name": "CINQ — Product Carousel",
  "tag": "section",
  "class": "section-cinq-loop-product-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "REFRESH YOUR LOOK"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore the selection that will transform your wardrobe"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row on desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Products per row on mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "CINQ — Product Carousel"
    }
  ]
}
{% endschema %}
