{% liquid
  assign selected_collection = section.settings.collection
  assign product_limit = section.settings.product_limit
  assign real_count = 0

  if selected_collection != blank
    assign real_count = selected_collection.products.size
    if real_count > product_limit
      assign real_count = product_limit
    endif
  endif
%}

<section
  class="cinq-featured-carousel color-{{ section.settings.color_scheme }}"
  data-cinq-featured-carousel
  data-section-id="{{ section.id }}"
  data-count="{{ real_count }}"
  style="
    --cinq-carousel-columns-desktop: {{ section.settings.columns_desktop }};
    --cinq-carousel-columns-mobile: {{ section.settings.columns_mobile }};
    --cinq-carousel-gap-desktop: {{ section.settings.gap_desktop }}px;
    --cinq-carousel-gap-mobile: {{ section.settings.gap_mobile }}px;
    --cinq-carousel-image-bg: {{ section.settings.image_background }};
    --cinq-carousel-text-color: {{ section.settings.text_color }};
    --cinq-carousel-muted-color: {{ section.settings.muted_color }};
    --cinq-carousel-arrow-color: {{ section.settings.arrow_color }};
    --cinq-carousel-padding-top: {{ section.settings.padding_top }}px;
    --cinq-carousel-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cinq-featured-carousel__inner {% unless section.settings.full_width %}page-width{% endunless %}">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="cinq-featured-carousel__header">
        {% if section.settings.heading != blank %}
          <h2 class="cinq-featured-carousel__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="cinq-featured-carousel__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if selected_collection != blank and real_count > 0 %}
      <div class="cinq-featured-carousel__shell">
        {% if section.settings.show_arrows %}
          <button class="cinq-featured-carousel__arrow cinq-featured-carousel__arrow--prev" type="button" aria-label="Previous products">
            <span aria-hidden="true">‹</span>
          </button>
        {% endif %}

        <div class="cinq-featured-carousel__viewport">
          <div class="cinq-featured-carousel__track">
            {% for repeat in (1..3) %}
              {% for product in selected_collection.products limit: product_limit %}
                <a class="cinq-featured-carousel__slide" href="{{ product.url }}">
                  <div class="cinq-featured-carousel__image-frame">
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          class: 'cinq-featured-carousel__image',
                          widths: '260, 360, 480, 600, 750, 900, 1000',
                          sizes: '(min-width: 1200px) 16vw, (min-width: 750px) 22vw, 44vw',
                          alt: product.featured_image.alt
                      }}
                    {% else %}
                      <div class="cinq-featured-carousel__placeholder">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>

                  <div class="cinq-featured-carousel__product-info">
                    {% if section.settings.show_season %}
                      {% liquid
                        assign product_season = product.metafields.custom.season
                        if product_season == blank
                          assign product_season = section.settings.season_fallback
                        endif
                      %}

                      {% if product_season != blank %}
                        <div class="cinq-featured-carousel__season">{{ product_season }}</div>
                      {% endif %}
                    {% endif %}

                    {% if section.settings.show_vendor and product.vendor != blank %}
                      <div class="cinq-featured-carousel__vendor">{{ product.vendor }}</div>
                    {% endif %}

                    <div class="cinq-featured-carousel__title">{{ product.title }}</div>

                    <div class="cinq-featured-carousel__price">
                      {% if product.compare_at_price > product.price and section.settings.show_compare_price %}
                        <span class="cinq-featured-carousel__compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                      <span class="cinq-featured-carousel__current-price">{{ product.price | money }}</span>
                    </div>
                  </div>
                </a>
              {% endfor %}
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_arrows %}
          <button class="cinq-featured-carousel__arrow cinq-featured-carousel__arrow--next" type="button" aria-label="Next products">
            <span aria-hidden="true">›</span>
          </button>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank %}
        <div class="cinq-featured-carousel__button-wrap">
          <a
            class="cinq-featured-carousel__button"
            href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}{{ selected_collection.url }}{% endif %}"
          >
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="cinq-featured-carousel__empty">Choose a collection in this section settings.</div>
    {% endif %}
  </div>
</section>

<style>
  .cinq-featured-carousel {
    padding-top: var(--cinq-carousel-padding-top);
    padding-bottom: var(--cinq-carousel-padding-bottom);
    background: rgb(var(--color-background));
    color: var(--cinq-carousel-text-color);
    overflow: hidden;
  }

  .cinq-featured-carousel__inner {
    position: relative;
  }

  .cinq-featured-carousel__header {
    max-width: 920px;
    margin: 0 auto 92px;
    padding: 0 18px;
    text-align: center;
  }

  .cinq-featured-carousel__heading {
    margin: 0;
    color: var(--cinq-carousel-text-color);
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(30px, 2.8vw, 44px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .cinq-featured-carousel__subheading {
    max-width: 760px;
    margin: 18px auto 0;
    color: var(--cinq-carousel-muted-color);
    font-family: var(--font-body--family, inherit);
    font-size: clamp(15px, 1.35vw, 21px);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: 0.16em;
  }

  .cinq-featured-carousel__shell {
    position: relative;
  }

  .cinq-featured-carousel__viewport {
    overflow: hidden;
    width: 100%;
  }

  .cinq-featured-carousel__track {
    display: flex;
    gap: var(--cinq-carousel-gap-desktop);
    will-change: transform;
    touch-action: pan-y;
  }

  .cinq-featured-carousel__slide {
    flex: 0 0 calc((100% - (var(--cinq-carousel-gap-desktop) * (var(--cinq-carousel-columns-desktop) - 1))) / var(--cinq-carousel-columns-desktop));
    color: inherit;
    text-decoration: none;
  }

  .cinq-featured-carousel__image-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.5;
    background: var(--cinq-carousel-image-bg);
    overflow: hidden;
  }

  .cinq-featured-carousel__image,
  .cinq-featured-carousel__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cinq-featured-carousel__image {
    object-fit: contain;
    padding: 14px;
    transition: transform 500ms ease;
  }

  .cinq-featured-carousel__slide:hover .cinq-featured-carousel__image {
    transform: scale(1.025);
  }

  .cinq-featured-carousel__product-info {
    padding: 34px 10px 0;
    text-align: center;
  }

  .cinq-featured-carousel__season {
    margin-bottom: 7px;
    color: var(--cinq-carousel-muted-color);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .cinq-featured-carousel__vendor {
    color: var(--cinq-carousel-text-color);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cinq-featured-carousel__title {
    max-width: 210px;
    min-height: 40px;
    margin: 23px auto 0;
    color: var(--cinq-carousel-muted-color);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .cinq-featured-carousel__price {
    margin-top: 30px;
    color: var(--cinq-carousel-text-color);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .cinq-featured-carousel__compare-price {
    margin-right: 8px;
    color: var(--cinq-carousel-muted-color);
    text-decoration: line-through;
  }

  .cinq-featured-carousel__arrow {
    position: absolute;
    top: 33%;
    z-index: 2;
    width: 48px;
    height: 64px;
    border: 0;
    background: transparent;
    color: var(--cinq-carousel-arrow-color);
    font-size: 58px;
    font-weight: 100;
    line-height: 1;
    cursor: pointer;
    opacity: 0.8;
    transform: translateY(-50%);
    transition: color 180ms ease, opacity 180ms ease;
  }

  .cinq-featured-carousel__arrow:hover {
    color: var(--cinq-carousel-text-color);
    opacity: 1;
  }

  .cinq-featured-carousel__arrow--prev {
    left: 0;
  }

  .cinq-featured-carousel__arrow--next {
    right: 0;
  }

  .cinq-featured-carousel__button-wrap {
    margin-top: 74px;
    text-align: center;
  }

  .cinq-featured-carousel__button {
    display: inline-block;
    color: var(--cinq-carousel-muted-color);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.07em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cinq-featured-carousel__button:hover {
    color: var(--cinq-carousel-text-color);
  }

  .cinq-featured-carousel__empty {
    padding: 40px 20px;
    color: var(--cinq-carousel-muted-color);
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .cinq-featured-carousel__inner:not(.page-width) {
      padding-left: 10vw;
      padding-right: 10vw;
    }
  }

  @media screen and (max-width: 989px) {
    .cinq-featured-carousel__header {
      margin-bottom: 68px;
    }

    .cinq-featured-carousel__arrow--prev {
      left: -10px;
    }

    .cinq-featured-carousel__arrow--next {
      right: -10px;
    }
  }

  @media screen and (max-width: 749px) {
    .cinq-featured-carousel {
      padding-top: calc(var(--cinq-carousel-padding-top) * 0.72);
      padding-bottom: calc(var(--cinq-carousel-padding-bottom) * 0.72);
    }

    .cinq-featured-carousel__inner {
      padding-left: 28px;
      padding-right: 28px;
    }

    .cinq-featured-carousel__header {
      margin-bottom: 66px;
      padding: 0 6px;
    }

    .cinq-featured-carousel__heading {
      font-size: 32px;
      letter-spacing: 0.055em;
    }

    .cinq-featured-carousel__subheading {
      margin-top: 18px;
      font-size: 20px;
      line-height: 1.28;
      letter-spacing: 0.12em;
    }

    .cinq-featured-carousel__track {
      gap: var(--cinq-carousel-gap-mobile);
    }

    .cinq-featured-carousel__slide {
      flex-basis: calc((100% - (var(--cinq-carousel-gap-mobile) * (var(--cinq-carousel-columns-mobile) - 1))) / var(--cinq-carousel-columns-mobile));
    }

    .cinq-featured-carousel__image-frame {
      aspect-ratio: 1 / 1.5;
    }

    .cinq-featured-carousel__product-info {
      padding-top: 31px;
    }

    .cinq-featured-carousel__season {
      font-size: 12px;
    }

    .cinq-featured-carousel__vendor {
      font-size: 15px;
      letter-spacing: 0.12em;
    }

    .cinq-featured-carousel__title {
      max-width: 160px;
      margin-top: 25px;
      font-size: 13px;
    }

    .cinq-featured-carousel__price {
      margin-top: 30px;
      font-size: 15px;
    }

    .cinq-featured-carousel__arrow {
      top: 39%;
      width: 30px;
      height: 48px;
      font-size: 48px;
    }

    .cinq-featured-carousel__arrow--prev {
      left: 1px;
    }

    .cinq-featured-carousel__arrow--next {
      right: 1px;
    }

    .cinq-featured-carousel__button-wrap {
      margin-top: 80px;
    }
  }
</style>

<script>
  (() => {
    const SELECTOR = '[data-cinq-featured-carousel]';

    function initCinqFeaturedCarousel(section) {
      if (!section || section.dataset.cinqFeaturedInitialized === 'true') return;

      const realCount = Number(section.dataset.count || 0);
      const track = section.querySelector('.cinq-featured-carousel__track');
      const prev = section.querySelector('.cinq-featured-carousel__arrow--prev');
      const next = section.querySelector('.cinq-featured-carousel__arrow--next');

      if (!track || realCount <= 1) return;

      section.dataset.cinqFeaturedInitialized = 'true';

      let index = realCount;
      let isLocked = false;
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      function getGap() {
        return parseFloat(window.getComputedStyle(track).columnGap || window.getComputedStyle(track).gap || 0);
      }

      function getSlideWidth() {
        const slide = track.querySelector('.cinq-featured-carousel__slide');
        if (!slide) return 0;
        return slide.getBoundingClientRect().width + getGap();
      }

      function getTranslate() {
        return -index * getSlideWidth();
      }

      function setPosition(withAnimation = true, offset = 0) {
        const width = getSlideWidth();
        if (!width) return;

        track.style.transition = withAnimation ? 'transform 450ms ease' : 'none';
        track.style.transform = `translate3d(${getTranslate() + offset}px, 0, 0)`;
      }

      function normalizeIndex() {
        if (index >= realCount * 2) {
          index = realCount;
          setPosition(false);
        }

        if (index < realCount) {
          index = realCount * 2 - 1;
          setPosition(false);
        }
      }

      function move(direction) {
        if (isLocked) return;
        isLocked = true;
        index += direction;
        setPosition(true);
      }

      track.addEventListener('transitionend', () => {
        normalizeIndex();
        window.requestAnimationFrame(() => {
          isLocked = false;
        });
      });

      if (prev) prev.addEventListener('click', () => move(-1));
      if (next) next.addEventListener('click', () => move(1));

      track.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;

        isDragging = true;
        isLocked = true;
        startX = event.clientX;
        currentX = event.clientX;
        track.setPointerCapture(event.pointerId);
        setPosition(false);
      });

      track.addEventListener('pointermove', (event) => {
        if (!isDragging) return;
        currentX = event.clientX;
        setPosition(false, currentX - startX);
      });

      track.addEventListener('pointerup', () => {
        if (!isDragging) return;

        const distance = currentX - startX;
        const threshold = Math.max(35, getSlideWidth() * 0.18);

        isDragging = false;
        isLocked = false;

        if (distance > threshold) {
          move(-1);
        } else if (distance < -threshold) {
          move(1);
        } else {
          setPosition(true);
        }
      });

      track.addEventListener('pointercancel', () => {
        isDragging = false;
        isLocked = false;
        setPosition(true);
      });

      window.addEventListener('resize', () => setPosition(false));
      setPosition(false);
    }

    function initAllCinqFeaturedCarousels() {
      document.querySelectorAll(SELECTOR).forEach(initCinqFeaturedCarousel);
    }

    document.addEventListener('DOMContentLoaded', initAllCinqFeaturedCarousels);
    document.addEventListener('shopify:section:load', (event) => {
      initCinqFeaturedCarousel(event.target.querySelector(SELECTOR));
    });
  })();
</script>

{% schema %}
{
  "name": "CINQ — Featured carousel",
  "tag": "section",
  "class": "section-cinq-featured-collection-carousel",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "REFRESH YOUR LOOK"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore the selection that will transform your wardrobe"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row on desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Products per row on mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_season",
      "label": "Show season line",
      "default": true
    },
    {
      "type": "text",
      "id": "season_fallback",
      "label": "Season fallback text",
      "default": "AUTUMN/WINTER 2026",
      "info": "Used when product metafield custom.season is empty."
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Use full width spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Product image background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text color",
      "default": "#777777"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#d8d8d8"
    }
  ],
  "presets": [
    {
      "name": "CINQ — Featured carousel"
    }
  ]
}
{% endschema %}
